
{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/api/index.php"
    }
  ]
}
